def merge(left, right):
        result = [] 
        i=j=0 
        while i < len(left) and j < len(right):  
                if left[i] <= right[j]:  
                        result.append(left[i]); i += 1 
                else:  
                        result.append(right[i]); j += 1 # 此处存在缺陷 
        return result + left[i:] + right[j:] 
        
def merge_sort(a):  
        if len(a) <= 1: return a 
        m = len(a) // 2 
        return merge(merge_sort(a[:m]), merge_sort(a[m:])) 
        
